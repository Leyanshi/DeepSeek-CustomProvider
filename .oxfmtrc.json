{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "release/**",
    "test-results/**",
    ".android-tools/**",
    "android/build/**",
    "android/.signing/**",
    "pnpm-lock.yaml"
  ]
}
